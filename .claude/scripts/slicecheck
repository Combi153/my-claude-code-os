#!/usr/bin/env python3
"""slicecheck - 한 슬라이스의 기계 절차 일곱 단계를 돌리고 `state.json` 에 회차를 쓴다.

    slicecheck <slice-dir> --stage <목록>   [--corpus <file>] [--surface <key>]
                                            [--note <text>] [--json] [--dry-run]
                                            [--config <file>]
    slicecheck <slice-dir> --init --slice <id> [--unit <sym>] [--area <이름>]
                                            [--depth shallow|normal|deep]
                                            [--cap L2=5,L3=3]
    slicecheck <slice-dir> --show [--json]

  --stage 는 목록과 범위를 받는다: `3`, `3,4,7`, `1..7`, `3-5`, 섞어도 된다.

| 단계 | 하는 일 | 통과 조건 |
|---|---|---|
| 1 환경 | 백엔드 스키마 · 상류 도달 · 되읽기가 자리표시자 아님 · 컨테이너 이름 대조 | 넷 다 |
| 2 잡음 | 토글 `legacy` 로 두고 레거시 대 레거시 이중 실행 → `diff_keys` 를 씨앗으로 | 씨앗 생성 |
| 3 dual | 토글 `dual` → 되읽기 → 캡처 → `dualrun-report` | 예상 밖 불일치 0 |
| 4 migrated | 토글 `migrated` → 되읽기 → 캡처 → 기준선 비교 | 차이 0 (차이가 있으면 원장 힌트와 함께 사람에게) |
| 5 독 | `migrated` 에서 레거시 반환값을 독으로 바꿔 캡처 | 골든이 **동일**해야 통과 · 본문 해시 그대로 |
| 6 커버리지 | (Xdebug 가 있으면) 옮긴 레거시 본문의 실행 줄 | 0. 없으면 건너뛰고 그 사실을 `state.json` 에 |
| 7 복귀 | 토글 `legacy` · 계측 봉투 해제 · `state.json` 기록 | 되읽기로 확인 |

**이 파일과 오케스트레이터만 `state.json` 을 쓴다.** 서브에이전트는 읽지도 쓰지도 않는다.
회차·상한은 이 파일이 올리고, `slice`·`unit`·`area`·`depth`·`phase`·상한값은 오케스트레이터가
`--init` 으로 놓는다. **없거나 깨진 `state.json` 을 조용히 새로 만들지 않는다** — 그렇게 하면
상한을 넘긴 루프가 회차 1 로 되살아나고, 두 번째 슬라이스에서 L2 가 상한의 두 배를 돈 것을
아무도 보지 못한 이유가 정확히 카운터가 없었기 때문이다.

**토글은 이 파일만 만진다.** 매번 `htmlsnap toggle --expect` 로 애플리케이션에서 되읽고,
되읽은 값이 기대와 다르면 **캡처하지 않고 멈춘다.** env 파일에 값을 쓰는 것과 그 값이 PHP 에
도달하는 것은 다른 일이고, 어긋난 토글로 찍은 캡처는 자신 있고 틀린 동등성 결과를 만든다.

**기능을 다시 구현하지 않는다.** 캡처·비교는 `htmlsnap`, 불일치 집계는 `dualrun-report`,
본문 해시는 `phpseam check`, 설정 로딩은 `_phpenc` 가 한다. 이 파일이 가진 것은 순서·토글·
회차·게이지뿐이다.

종료 코드:
    0  통과
    1  실패 — 검사가 돌았고 빨간불이다
    2  잘못된 사용
    3  **검사할 수 없었다** — 환경·설정·도구 부재. 0 과 섞이면 이 도구의 존재 이유가 없다
    4  상한 도달 — 진행하지 않았다. 1 과 구별한다(빨간불이 아니라 예산 소진이다)
"""
import datetime
import json
import os
import shutil
import socket
import subprocess
import sys
import urllib.parse

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from _phpenc import dotted, is_placeholder, workspace  # noqa: E402

TOOL = "slicecheck"
HTMLSNAP = os.path.join(HERE, "htmlsnap")
DUALRUN = os.path.join(HERE, "dualrun-report")
PHPSEAM = os.path.join(HERE, "phpseam")

STAGES = {1: "환경", 2: "잡음", 3: "dual", 4: "migrated", 5: "독",
          6: "커버리지", 7: "복귀"}
# 회차를 세는 루프. 단계가 어느 루프의 예산을 쓰는가 — 3·4 는 동등성(L2),
# 5·6 은 완전성(L3). 1·2·7 은 준비와 정리라 예산을 쓰지 않는다.
STAGE_LOOP = {3: "L2", 4: "L2", 5: "L3", 6: "L3"}
GAUGES = ("unexpected", "golden_diff", "poison", "legacy_lines")

EXIT_OK, EXIT_RED, EXIT_USAGE, EXIT_CANNOT, EXIT_CAP = 0, 1, 2, 3, 4


def note(msg):
    sys.stderr.write(f"{TOOL}: {msg}\n")


def usage(msg):
    sys.stderr.write(f"{TOOL}: {msg}\n")
    sys.exit(EXIT_USAGE)


def cannot(msg):
    """검사할 수 없는 상태. 좁은 답을 조용히 내는 대신 이유를 남기고 3 으로 멈춘다."""
    sys.stderr.write(f"{TOOL}: {msg}\n")
    sys.exit(EXIT_CANNOT)


# --------------------------------------------------------------- 설정

class Env(object):
    """설정에서 읽은 값들. **키가 없으면 어느 키가 없는지 말하고 멈춘다.**

    단계마다 자기 키만 요구한다. 부르지 않은 단계의 키가 없다고 멈추면, 단계
    하나를 돌리려고 설정 전체를 채워야 하고 그러면 아무도 단계 하나만 돌리지
    않는다.
    """

    def __init__(self, cfg, path, slice_id, surface):
        self.cfg = cfg
        self.path = path
        self.slice_id = slice_id
        self.surface = surface

    def get(self, key, why):
        val = dotted(self.cfg, key)
        if val is None:
            cannot(f"{self.path} 에 {key} 가 없다. {why}")
        if is_placeholder(val):
            cannot(f"{self.path} 의 {key} 가 골격의 자리표시자 그대로다 ({val!r}). "
                   f"{why} — 채우지 않은 키는 없는 키보다 위험하다: 값이 있는 것처럼 "
                   "통과해서 그 뒤의 모든 판정을 엉뚱한 곳에 대고 내린다.")
        return val

    def maybe(self, key, default=None):
        val = dotted(self.cfg, key, default)
        return default if is_placeholder(val) else val

    def surface_get(self, key, why):
        return self.get(f"legacy.surfaces.{self.surface}.{key}", why)

    def toggle_var(self):
        pattern = self.get("legacy.switch.envVarPattern",
                           "토글 환경변수 이름을 만들 수 없으면 모드를 바꿀 수 없다.")
        name = pattern.replace("{SLICE}", slug(self.slice_id))
        if "<" in name or ">" in name:
            cannot(f"토글 환경변수 이름에 자리표시자가 남았다 ({name!r}). "
                   "legacy.switch.envVarPattern 의 접두사를 실제 값으로 채워라.")
        return name

    def toggle_value(self, mode):
        return self.get(f"legacy.switch.values.{mode}",
                        f"{mode} 모드의 환경변수 값을 모르면 그 모드로 바꿀 수 없다.")


def slug(text):
    return "".join(c if c.isalnum() else "_" for c in str(text)).upper()


# --------------------------------------------------------------- state.json

def state_path(slice_dir):
    return os.path.join(slice_dir, "state.json")


def read_state(slice_dir):
    """`state.json`, 또는 멈춘다. **없는 것을 새로 만들지 않는다.**"""
    path = state_path(slice_dir)
    if not os.path.isfile(path):
        cannot(f"{path} 가 없다. 오케스트레이터가 `slicecheck {slice_dir} --init "
               "--slice <id>` 로 먼저 놓아야 한다. 없는 회차 기록을 이 도구가 "
               "만들면 상한을 넘긴 루프가 회차 1 로 되살아난다.")
    try:
        with open(path, encoding="utf-8") as fh:
            doc = json.load(fh)
    except (OSError, ValueError) as exc:
        cannot(f"{path} 를 읽을 수 없다: {exc}. 고쳐서 다시 불러라 — 깨진 기록을 "
               "덮어쓰면 그 전에 몇 회차를 돌았는지 아무도 모른다.")
    bad = state_problems(doc)
    if bad:
        cannot(f"{path} 의 형태가 계약과 다르다: {'; '.join(bad)}. 고쳐서 다시 "
               "불러라 — 이 도구는 깨진 기록을 새로 만들지 않는다.")
    return doc, path


def state_problems(doc):
    bad = []
    if not isinstance(doc, dict):
        return ["최상위가 객체가 아니다"]
    if not doc.get("slice"):
        bad.append("slice 가 없다")
    loops = doc.get("loops")
    if not isinstance(loops, dict) or not loops:
        bad.append("loops 객체가 없다")
    else:
        for name, val in loops.items():
            if not isinstance(val, dict) or not isinstance(val.get("n"), int) \
                    or not isinstance(val.get("cap"), int):
                bad.append(f"loops.{name} 이 {{'n': int, 'cap': int}} 가 아니다")
    if not isinstance(doc.get("gauges"), dict):
        bad.append("gauges 객체가 없다")
    if not isinstance(doc.get("rounds"), list):
        bad.append("rounds 배열이 없다")
    return bad


def write_state(doc, path):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, ensure_ascii=False, indent=1, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)


def now():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def cmd_init(slice_dir, o):
    if not o.get("--slice"):
        usage("--init 에는 --slice <id> 가 필요하다.")
    path = state_path(slice_dir)
    if os.path.isfile(path):
        cannot(f"{path} 가 이미 있다. --init 은 덮어쓰지 않는다 — 회차 기록을 "
               "지우는 것이 가장 쉬운 상한 회피이기 때문이다.")
    caps = {"L0": 3, "cov": 2, "L1": 5, "L2": 5, "L3": 3}
    for item in (o.get("--cap") or "").split(","):
        if not item.strip():
            continue
        if "=" not in item:
            usage(f"--cap 은 `L2=5,L3=3` 형태다 (받은 값 {item!r})")
        name, _, val = item.partition("=")
        if name.strip() not in caps:
            usage(f"모르는 루프 {name.strip()!r}. 있는 것: {', '.join(caps)}")
        try:
            caps[name.strip()] = int(val)
        except ValueError:
            usage(f"--cap 의 값이 정수가 아니다 ({val!r})")
    doc = {"slice": o["--slice"], "unit": o.get("--unit") or "",
           "area": o.get("--area") or "", "depth": o.get("--depth") or "shallow",
           "phase": 0,
           "loops": {k: {"n": 0, "cap": v} for k, v in caps.items()},
           # 측정 전에는 0 이 아니라 null 이다. 0 은 재고 나서 깨끗하다는 뜻이고,
           # 측정하지 않은 것을 0 으로 적으면 그 게이지는 영원히 초록이다.
           "gauges": {g: None for g in GAUGES},
           "toggle": None, "skips": {}, "rounds": []}
    os.makedirs(slice_dir, exist_ok=True)
    write_state(doc, path)
    print(f"{TOOL} --init: {path}  슬라이스 {doc['slice']} · 상한 "
          + " · ".join(f"{k} {v['cap']}" for k, v in sorted(doc["loops"].items())))
    return EXIT_OK


def cmd_show(slice_dir, as_json):
    doc, path = read_state(slice_dir)
    if as_json:
        print(json.dumps(doc, ensure_ascii=False, indent=2, sort_keys=True))
        return EXIT_OK
    print(f"{TOOL} {path}")
    print(f"  슬라이스 {doc['slice']} · 단위 {doc.get('unit') or '-'} · 영역 "
          f"{doc.get('area') or '-'} · depth {doc.get('depth')} · phase "
          f"{doc.get('phase')} · 토글 {doc.get('toggle') or '-'}")
    print("  루프  " + " · ".join(f"{k} {v['n']}/{v['cap']}"
                                  for k, v in sorted(doc["loops"].items())))
    print("  게이지 " + " · ".join(
        f"{g}={fmt(doc['gauges'].get(g))}" for g in GAUGES))
    for name, why in sorted((doc.get("skips") or {}).items()):
        print(f"  건너뜀 단계 {name}: {why}")
    for r in doc["rounds"][-8:]:
        print(f"  회차 {r.get('n')}  단계 {r.get('stage')}  {r.get('verdict')}  "
              f"{r.get('at')}  {r.get('note') or ''}")
    return EXIT_OK


def fmt(value):
    return "미측정" if value is None else str(value)


# --------------------------------------------------------------- 외부 도구

def run(args, timeout=900, env=None):
    """(returncode, stdout, stderr). 예외를 밖으로 내지 않는다."""
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout,
                           env=env or os.environ.copy())
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return None, "", f"{args[0]} 이 {timeout}초 안에 끝나지 않았다"
    except OSError as exc:
        return None, "", str(exc)


def tool(script, args, timeout=900):
    return run([sys.executable, script] + args, timeout=timeout)


def docker(env, args, timeout=300):
    """compose 하위 명령. `docker` 가 없으면 검사할 수 없는 상태다."""
    exe = shutil.which("docker")
    if not exe:
        cannot("docker 를 PATH 에서 찾지 못했다. 토글을 바꾸려면 표면을 서비스하는 "
               "컨테이너를 다시 만들어야 하고, 그것 없이는 env 파일만 바뀐다.")
    compose_dir = env.get("legacy.docker.composeDir",
                          "compose 프로젝트 디렉터리 없이는 컨테이너를 다룰 수 없다.")
    env_file = env.get("legacy.docker.envFile",
                       "마이그레이션 토글이 실린 compose env 파일이 필요하다.")
    return run([exe, "compose", "--project-directory", compose_dir,
                "--env-file", env_file] + args, timeout=timeout)


# --------------------------------------------------------------- env 파일

def read_env_file(path):
    """(순서 있는 줄 목록). 주석과 빈 줄과 모르는 형태를 그대로 보존한다."""
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().splitlines()
    except FileNotFoundError:
        cannot(f"compose env 파일이 없다: {path}. legacy.docker.envFile 이 실제로 "
               "compose 가 읽는 파일을 가리키는지 확인해라.")
    except OSError as exc:
        cannot(f"compose env 파일을 읽을 수 없다 ({path}): {exc}")


def set_env_keys(path, pairs):
    """`KEY=VALUE` 를 세팅하거나(값이 None 이면) 지운다. 다른 줄은 한 글자도 건드리지 않는다.

    이 파일은 우리 것이 아니다 — 다른 서비스의 값이 같이 살고, 그 값을 한 줄이라도
    다시 써 버리면 이 도구가 만든 변화와 코드가 만든 변화를 구분할 수 없게 된다.
    """
    lines = read_env_file(path)
    out, seen = [], set()
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            out.append(line)
            continue
        key = stripped.split("=", 1)[0].strip()
        if key in pairs:
            seen.add(key)
            if pairs[key] is not None:
                out.append(f"{key}={pairs[key]}")
            # None 이면 줄을 지운다 — 빈 값과 없는 값은 헬퍼에게 같은 뜻이지만,
            # 남은 빈 줄은 사람에게 "이 봉투가 켜져 있었다"로 읽힌다.
            continue
        out.append(line)
    for key, val in pairs.items():
        if key not in seen and val is not None:
            out.append(f"{key}={val}")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out).rstrip("\n") + "\n")


# --------------------------------------------------------------- 토글

def set_toggle(env, mode, extra=None, verbose=True):
    """env 파일에 쓰고 컨테이너를 다시 만들고 **애플리케이션에서 되읽는다.**

    되읽기가 기대와 다르면 여기서 멈춘다. 호출자가 캡처로 넘어갈 수 없게 만드는
    것이 이 함수의 목적이다.
    """
    env_file = env.get("legacy.docker.envFile",
                       "토글 값을 쓸 compose env 파일이 필요하다.")
    pairs = {env.toggle_var(): env.toggle_value(mode)}
    pairs.update(extra or {})
    set_env_keys(env_file, pairs)

    container = env.surface_get(
        "container", "어느 컨테이너가 이 표면을 서비스하는지 모르면 env 변경이 "
                     "이미 돌고 있는 컨테이너에 도달하지 않는다.")
    code, out, err = docker(env, ["up", "-d", "--force-recreate", container])
    if code != 0:
        cannot(f"컨테이너 {container} 를 다시 만들지 못했다 (exit {code}): "
               f"{(err or out).strip()[-500:]}")
    return readback(env, mode, verbose=verbose)


def readback(env, expect, verbose=True):
    """`htmlsnap toggle --expect` 로 되읽는다. 어긋나면 멈춘다."""
    args = ["toggle", "--surface", env.surface, "--expect", expect,
            "--config", env.path]
    code, out, err = tool(HTMLSNAP, args, timeout=120)
    if code != 0:
        cannot(f"토글 되읽기가 {expect!r} 를 확인하지 못했다: "
               f"{(err or out).strip()[-500:]}")
    if verbose:
        note(f"토글 되읽기: {out.strip()} (기대와 같다)")
    return out.strip()


def clear_envelopes(env):
    """잡음·독 봉투를 지운다. 지우고 나서 컨테이너를 다시 만드는 것은 호출자가 한다."""
    env_file = env.maybe("legacy.docker.envFile")
    if not env_file:
        return {}
    pairs = {}
    for key in ("legacy.dualRun.noiseEnvVar", "legacy.dualRun.poisonEnvVar"):
        name = env.maybe(key)
        if name:
            pairs[name] = None
    return pairs


# --------------------------------------------------------------- 헬퍼 지원

def helper_file(env):
    """트리에 설치된 실험 헬퍼의 경로. 없으면 None."""
    base = env.maybe("legacy.switch.helperPath")
    if not base:
        return None
    base = os.path.expanduser(base)
    for cand in (base,
                 os.path.join(base, "MigrationExperiment.php"),
                 os.path.join(os.path.dirname(base), "MigrationExperiment.php")):
        if os.path.isfile(cand) and cand.endswith(".php"):
            return cand
    return None


def helper_supports(env, const, envvar_key, what):
    """헬퍼가 이 계측 봉투를 지원하는가. (환경변수 이름, 문제).

    지원하지 않으면 **조용히 건너뛰지 않는다.** 지원 여부를 모르는 채 단계를 초록으로
    적는 것이 이 도구가 막으려는 실패다.
    """
    name = env.maybe(envvar_key)
    if not name:
        return None, (f"{env.path} 에 {envvar_key} 가 없다. {what}")
    path = helper_file(env)
    if not path:
        return None, (f"legacy.switch.helperPath 아래에서 MigrationExperiment.php 를 "
                      f"찾지 못했다. {what} — 헬퍼가 어디 설치됐는지 모르면 지원 "
                      "여부를 확인할 수 없고, 확인하지 않은 지원은 지원이 아니다.")
    try:
        with open(path, "rb") as fh:
            body = fh.read()
    except OSError as exc:
        return None, f"{path} 를 읽을 수 없다: {exc}"
    if (b"const " + const.encode()) not in body:
        return None, (
            f"설치된 헬퍼({path})에 {const} 상수가 없다 — 이 모드를 지원하지 않는다. "
            f"{what} `.claude/templates/MigrationExperiment.php` 의 현재 판을 "
            f"다시 복사하면 된다 (그 판은 {const} 와 그것을 읽는 분기를 갖고 있다).")
    if name.encode() not in body:
        return None, (f"설치된 헬퍼({path})의 {const} 값이 설정의 {envvar_key}"
                      f"({name}) 와 다르다. 두 곳이 갈리면 봉투는 켜지지 않고, "
                      "그 사실은 '불일치가 없었다'와 같은 모양으로 도착한다.")
    return name, None


# --------------------------------------------------------------- 단계

class Result(object):
    def __init__(self, ok, line, code=None, gauges=None, skip=None, extra=None):
        self.ok = ok
        self.line = line
        self.code = code if code is not None else (EXIT_OK if ok else EXIT_RED)
        self.gauges = gauges or {}
        self.skip = skip
        self.extra = extra or {}


def captures(slice_dir, name):
    return os.path.join(slice_dir, "captures", name)


def corpus_surface(path):
    try:
        with open(path, encoding="utf-8") as fh:
            doc = json.load(fh)
    except (OSError, ValueError) as exc:
        cannot(f"코퍼스를 읽을 수 없다 ({path}): {exc}")
    surface = doc.get("surface") if isinstance(doc, dict) else None
    if not surface:
        cannot(f"{path} 에 surface 가 없다. 어느 표면을 두드릴지 모르면 캡처도 "
               "되읽기도 할 수 없다.")
    return surface


def capture(env, ctx, mode, out_dir):
    """`htmlsnap capture`. 되읽기는 호출자가 이미 했고, 캡처도 한 번 더 확인한다."""
    code, out, err = tool(HTMLSNAP, [
        "capture", "--corpus", ctx["corpus"], "--out", out_dir,
        "--toggle-expect", mode, "--config", env.path])
    if code == EXIT_USAGE or code is None:
        cannot(f"캡처가 답할 수 없는 상태로 끝났다 (exit {code}): "
               f"{(err or out).strip()[-800:]}")
    return code, out, err


# ---- 1 환경

def stage_environment(env, ctx):
    checks = []

    schema_dir = env.get("backend.graphqlSchemaDir",
                         "백엔드가 이 슬라이스의 스키마를 갖고 있는지 볼 곳이다.")
    root = env.get("backend.root", "백엔드 저장소 경로 없이는 스키마를 찾을 수 없다.")
    path = schema_dir if os.path.isabs(schema_dir) else os.path.join(root, schema_dir)
    files = []
    if os.path.isdir(path):
        for base, _dirs, names in os.walk(path):
            files += [os.path.join(base, n) for n in names if n.endswith(".graphqls")]
    checks.append(("백엔드 스키마", bool(files),
                   f"{len(files)}개" if files else f"{path} 에 .graphqls 가 없다"))

    base_url = env.surface_get("localBaseUrl", "상류에 닿는지 볼 곳이다.")
    reach_ok, reach_why = http_reach(base_url)
    port = env.maybe("backend.proxy.port")
    if port:
        ok2, why2 = tcp_reach(port)
        reach_ok, reach_why = (reach_ok and ok2,
                              "; ".join(x for x in (reach_why, why2) if x))
    checks.append(("상류 도달", reach_ok, reach_why or "표면·BFF 둘 다 응답"))

    readback_path = env.maybe("legacy.dualRun.readbackPath")
    values = dotted(env.cfg, "legacy.switch.values", {}) or {}
    holes = [k for k in ("legacy", "dual", "migrated")
             if not values.get(k) or is_placeholder(values.get(k))]
    if not readback_path or is_placeholder(readback_path) or holes:
        checks.append(("되읽기 설정", False,
                       f"readbackPath={readback_path!r} · 자리표시자인 모드 값 {holes}"))
    else:
        code, out, err = tool(HTMLSNAP, ["toggle", "--surface", env.surface,
                                         "--config", env.path], timeout=120)
        checks.append(("되읽기 설정", code == 0,
                       out.strip() if code == 0 else (err or out).strip()[-200:]))

    container = env.surface_get("container", "떠 있는 컨테이너와 대조할 이름이다.")
    code, out, _err = docker(env, ["ps", "--format", "{{.Service}}\t{{.State}}"])
    running = {}
    for line in (out or "").splitlines():
        if "\t" in line:
            svc, state = line.split("\t", 1)
            running[svc.strip()] = state.strip()
    state = running.get(container)
    checks.append(("컨테이너 대조", bool(state) and "run" in state.lower(),
                   f"{container}={state}" if state else
                   f"이 compose 프로젝트에 {container} 가 없다 (도는 것: "
                   + (", ".join(sorted(running)) or "없음") + ")"))

    bad = [c for c in checks if not c[1]]
    line = " · ".join(f"{n} {'OK' if ok else 'X'}" for n, ok, _ in checks)
    for n, ok, why in checks:
        if not ok:
            note(f"단계 1 {n}: {why}")
    # 단계 1 이 빨간불이면 그것은 검사 실패가 아니라 **검사할 수 없는 상태**다.
    # 아래 단계 전부가 이 넷에 기대 있으므로 3 으로 낸다.
    return Result(not bad, line, code=EXIT_OK if not bad else EXIT_CANNOT)


def http_reach(base_url):
    import urllib.error
    import urllib.request
    try:
        req = urllib.request.Request(base_url, headers={"User-Agent": TOOL})
        with urllib.request.urlopen(req, timeout=10) as resp:
            resp.read(64)
        return True, ""
    except urllib.error.HTTPError as exc:
        return True, f"표면 {exc.code}"          # 4xx·5xx 도 닿은 것이다
    except Exception as exc:
        return False, f"표면에 못 닿았다 ({base_url}): {exc}"


def tcp_reach(port):
    try:
        with socket.create_connection(("127.0.0.1", int(port)), timeout=5):
            return True, ""
    except Exception as exc:
        return False, f"BFF 포트 {port} 에 못 닿았다: {exc}"


# ---- 2 잡음 바닥

def stage_noise(env, ctx):
    name, problem = helper_supports(
        env, "NOISE_ENV", "legacy.dualRun.noiseEnvVar",
        "단계 2 는 레거시 본문 대 레거시 본문 이중 실행이고, 그것은 토글이 legacy "
        "인 채로 헬퍼가 control 을 두 번 돌려 비교해야 성립한다.")
    if problem:
        return Result(False, f"헬퍼가 잡음 모드를 지원하지 않는다 — {problem}",
                      code=EXIT_CANNOT)

    log = env.get("legacy.dualRun.logPath",
                  "잡음 바닥은 헬퍼가 쓴 로그를 읽어야 나온다.")
    t0 = now()
    set_toggle(env, "legacy", extra={name: "1"})
    code, out, err = capture(env, ctx, "legacy", captures(ctx["dir"], "noise"))
    if code not in (0, 1):
        return Result(False, f"캡처가 답할 수 없다: {(err or out).strip()[-200:]}",
                      code=EXIT_CANNOT)

    rc, rout, rerr = tool(DUALRUN, ["--log", log, "--since", t0, "--json",
                                    "--config", env.path], timeout=300)
    if rc not in (0, 1):
        return Result(False,
                      "잡음 로그를 읽지 못했다 — 봉투가 PHP 에 도달하지 않았거나 로그 "
                      f"경로가 컨테이너 안에 없다: {(rerr or rout).strip()[-400:]}",
                      code=EXIT_CANNOT)
    try:
        report = json.loads(rout)
    except ValueError:
        return Result(False, "dualrun-report --json 을 해석하지 못했다",
                      code=EXIT_CANNOT)

    seeds = []
    for g in report.get("groups") or []:
        keys = [k for k in g.get("signature") or [] if k and not k.startswith("<")]
        if keys:
            seeds.append({"experiment": g.get("experiment"), "keys": keys,
                          "ledger": None, "origin": "noise",
                          "reason": f"잡음 바닥: 레거시 대 레거시에서도 움직인 키 "
                                    f"({g.get('count')}건, {t0} 이후 측정)"})
    added, kept = merge_ignore(env, ctx, seeds)
    return Result(True,
                  f"레거시 대 레거시 {report.get('records')}건 · 잡음 서명 "
                  f"{len(seeds)}가지 → 씨앗 {added}개 (사람이 승인한 규칙 {kept}개는 "
                  "그대로)",
                  extra={"noise_signatures": len(seeds)})


def ignore_path(env, ctx):
    name = env.maybe("legacy.dualRun.ignoreFile", "ignore.json")
    return name if os.path.isabs(name) else os.path.join(ctx["dir"], name)


def merge_ignore(env, ctx, seeds):
    """씨앗을 `ignore.json` 에 **합친다.** 사람이 승인한 규칙은 손대지 않는다.

    씨앗은 `origin: "noise"` 를 달고 있고 `ledger` 가 비어 있다 — 승인된 원장 행을
    가리키지 않기 때문이다. 그 구별이 없으면 잡음 억제와 승인된 교정이 같은 파일에서
    같은 모양으로 살고, 그러면 "이 키는 왜 무시되는가"에 답할 수 없다.
    """
    path = ignore_path(env, ctx)
    doc = {"rules": []}
    if os.path.isfile(path):
        try:
            with open(path, encoding="utf-8") as fh:
                doc = json.load(fh)
        except (OSError, ValueError) as exc:
            cannot(f"{path} 를 읽을 수 없다: {exc}. 잡음 씨앗을 합치려면 기존 규칙을 "
                   "먼저 읽어야 하고, 못 읽은 채로 덮어쓰면 승인된 교정이 사라진다.")
    if not isinstance(doc, dict) or not isinstance(doc.get("rules"), list):
        cannot(f"{path} 에 rules 배열이 없다. 형태를 고쳐서 다시 불러라.")
    human = [r for r in doc["rules"]
             if not (isinstance(r, dict) and r.get("origin") == "noise")]
    doc["rules"] = human + seeds
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, ensure_ascii=False, indent=2, sort_keys=True)
        fh.write("\n")
    return len(seeds), len(human)


# ---- 3 dual

def stage_dual(env, ctx):
    log = env.get("legacy.dualRun.logPath", "이중 실행 비교는 이 로그로만 읽는다.")
    ign = ignore_path(env, ctx)
    t0 = now()
    set_toggle(env, "dual", extra=clear_envelopes(env))
    code, out, err = capture(env, ctx, "dual", captures(ctx["dir"], "dual"))
    if code not in (0, 1):
        return Result(False, f"캡처가 답할 수 없다: {(err or out).strip()[-200:]}",
                      code=EXIT_CANNOT)
    invalid = code == 1

    args = ["--log", log, "--since", t0, "--json", "--config", env.path]
    if os.path.isfile(ign):
        args += ["--ignore", ign]
    rc, rout, rerr = tool(DUALRUN, args, timeout=300)
    if rc not in (0, 1):
        return Result(False,
                      "이중 실행 로그를 읽지 못했다 — 토글이 PHP 에 도달했더라도 로그 "
                      f"경로가 컨테이너 안에 없을 수 있다: {(rerr or rout).strip()[-400:]}",
                      code=EXIT_CANNOT)
    try:
        report = json.loads(rout)
    except ValueError:
        return Result(False, "dualrun-report --json 을 해석하지 못했다",
                      code=EXIT_CANNOT)
    unexpected = int(report.get("unexpected") or 0)
    noise_rules = count_noise_rules(ign)
    sigs = [",".join(g.get("signature") or []) for g in (report.get("groups") or [])]
    line = (f"{report.get('records')}건 · 예상 밖 {unexpected} · 서명 {len(sigs)}가지"
            + (f" [{'; '.join(sigs[:3])}]" if sigs else "")
            + (f" · ignore 중 잡음 출처 {noise_rules}개" if noise_rules else "")
            + (" · 캡처에 invalid 가 있다" if invalid else ""))
    return Result(unexpected == 0 and not invalid, line,
                  gauges={"unexpected": unexpected})


def count_noise_rules(path):
    if not os.path.isfile(path):
        return 0
    try:
        with open(path, encoding="utf-8") as fh:
            rules = json.load(fh).get("rules") or []
    except (OSError, ValueError):
        return 0
    return sum(1 for r in rules if isinstance(r, dict) and r.get("origin") == "noise")


# ---- 4 migrated

def stage_migrated(env, ctx):
    baseline = captures(ctx["dir"], "legacy")
    if not os.path.isfile(os.path.join(baseline, "manifest.json")):
        return Result(False,
                      f"기준선 캡처가 없다 ({baseline}). Phase 1 의 골든 마스터가 "
                      "먼저 있어야 migrated 를 비교할 대상이 있다.",
                      code=EXIT_CANNOT)
    out_dir = captures(ctx["dir"], "migrated")
    set_toggle(env, "migrated", extra=clear_envelopes(env))
    code, out, err = capture(env, ctx, "migrated", out_dir)
    if code not in (0, 1):
        return Result(False, f"캡처가 답할 수 없다: {(err or out).strip()[-200:]}",
                      code=EXIT_CANNOT)
    rc, rout, rerr = tool(HTMLSNAP, ["compare", baseline, out_dir,
                                     "--config", env.path], timeout=300)
    if rc not in (0, 1):
        return Result(False, f"비교가 답할 수 없다: {(rerr or rout).strip()[-300:]}",
                      code=EXIT_CANNOT)
    diff_ids = different_ids(rout)
    hints = ledger_hints(out_dir, diff_ids)
    line = (f"차이 {len(diff_ids)}개"
            + (f" [{', '.join(diff_ids[:5])}]" if diff_ids else "")
            + (f" · 그 코퍼스 항목이 인용한 원장 행 {', '.join(hints)}" if hints else ""))
    if diff_ids:
        note("단계 4 의 통과 조건은 '차이가 전부 의도수정 행으로 설명됨'이고, 그 "
             "판정은 기계가 하지 않는다. 위 원장 행을 읽고, 승인된 교정이면 "
             "ignore.json 에 그 행 ID 로 항목을 넣은 뒤 다시 돌려라. 설명되지 "
             "않으면 화면 규칙 누락이거나 어댑터 반환 형태다.")
    return Result(not diff_ids, line, gauges={"golden_diff": len(diff_ids)})


def different_ids(stdout):
    ids = []
    for line in (stdout or "").splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] in ("different", "missing"):
            ids.append(parts[1])
    return ids


def ledger_hints(capture_dir, ids):
    hints = set()
    for eid in ids:
        try:
            with open(os.path.join(capture_dir, f"{eid}.json"), encoding="utf-8") as fh:
                hints |= set(json.load(fh).get("rules") or [])
        except (OSError, ValueError):
            continue
    return sorted(hints)


# ---- 5 독 주입

def stage_poison(env, ctx):
    name, problem = helper_supports(
        env, "POISON_ENV", "legacy.dualRun.poisonEnvVar",
        "단계 5 는 migrated 에서 레거시 본문의 반환값을 독값으로 바꿔야 성립한다.")
    if problem:
        return Result(False, f"헬퍼가 독 주입을 지원하지 않는다 — {problem}",
                      code=EXIT_CANNOT)
    base = captures(ctx["dir"], "migrated")
    if not os.path.isfile(os.path.join(base, "manifest.json")):
        return Result(False,
                      f"migrated 기준선이 없다 ({base}). 단계 4 를 먼저 돌려라 — 독을 "
                      "넣은 화면을 무엇과 비교할지가 그 캡처다.",
                      code=EXIT_CANNOT)

    marker = f"SLICECHECK-{slug(ctx['slice'])}"
    out_dir = captures(ctx["dir"], "poison")
    set_toggle(env, "migrated", extra={name: marker})
    code, out, err = capture(env, ctx, "migrated", out_dir)
    if code not in (0, 1):
        set_toggle(env, "migrated", extra=clear_envelopes(env), verbose=False)
        return Result(False, f"캡처가 답할 수 없다: {(err or out).strip()[-200:]}",
                      code=EXIT_CANNOT)
    rc, rout, rerr = tool(HTMLSNAP, ["compare", base, out_dir,
                                     "--config", env.path], timeout=300)
    # 봉투는 이 단계 안에서 다시 끈다. 남겨 두면 다음 캡처가 독이 든 화면을 찍고,
    # 그 캡처는 아무 표시 없이 기준선이 된다.
    set_toggle(env, "migrated", extra=clear_envelopes(env), verbose=False)
    if rc not in (0, 1):
        return Result(False, f"비교가 답할 수 없다: {(rerr or rout).strip()[-300:]}",
                      code=EXIT_CANNOT)
    diff_ids = different_ids(rout)

    # 독은 래퍼만 건드리므로 본문 해시는 그대로여야 한다. 그 사실을 여기서 확인한다 —
    # Phase 7 까지 미루면 "독 주입이 통과했다"가 본문을 고쳐서 통과한 것과 구별되지
    # 않는다.
    pins = env.maybe("legacy.seam.pinsFile", "pins.json")
    pins = pins if os.path.isabs(pins) else os.path.join(ctx["dir"], pins)
    hash_ok, hash_why = True, "핀 확인"
    if not os.path.isfile(pins):
        hash_ok, hash_why = False, f"{pins} 가 없다 — 고정하지 않은 본문은 확인할 수 없다"
        hash_code = EXIT_CANNOT
    else:
        pc, pout, perr = tool(PHPSEAM, ["check", "--pins", pins,
                                        "--config", env.path], timeout=300)
        hash_code = EXIT_CANNOT if pc not in (0, 1) else EXIT_RED
        hash_ok = pc == 0
        hash_why = ("본문 해시 그대로" if pc == 0
                    else f"본문 해시가 움직였다: {(perr or pout).strip()[-300:]}")

    verdict = "pass" if (not diff_ids and hash_ok) else "fail"
    line = (f"독 {marker} · 골든 차이 {len(diff_ids)}개"
            + (f" [{', '.join(diff_ids[:5])}]" if diff_ids else " (동일)")
            + f" · {hash_why}")
    if diff_ids:
        note("독 주입에서 화면이 움직였다 = 화면의 그 값이 백엔드가 아니라 레거시에서 "
             "온다. 두 가지 중 하나다: 이음새 위에서 레거시 반환값을 쓰고 있거나, "
             "레거시 본문이 반환값이 아니라 부작용으로 화면 상태를 쓴다.")
    code_out = EXIT_OK if verdict == "pass" else (
        hash_code if not hash_ok else EXIT_RED)
    return Result(verdict == "pass", line, code=code_out,
                  gauges={"poison": verdict})


# ---- 6 커버리지

def stage_coverage(env, ctx):
    container = env.surface_get("container", "Xdebug 가 붙어 있는지 물어볼 곳이다.")
    code, out, err = docker(env, ["exec", "-T", container, "php", "-m"], timeout=120)
    if code is None:
        return Result(False, f"컨테이너에 물어볼 수 없었다: {(err or '').strip()[-200:]}",
                      code=EXIT_CANNOT)
    if code != 0 or "xdebug" not in (out or "").lower():
        why = ("레거시 컨테이너에 Xdebug 가 없다 (php -m 에 xdebug 가 없음)"
               if code == 0 else
               f"php -m 을 돌리지 못했다 (exit {code}) — Xdebug 유무를 확인하지 못했다")
        return Result(True, f"건너뜀 — {why}. **없는 것을 통과로 적지 않는다.**",
                      skip=why, gauges={"legacy_lines": None})

    cov_path = env.maybe("legacy.dualRun.coveragePath")
    if not cov_path:
        return Result(False,
                      f"{env.path} 에 legacy.dualRun.coveragePath 가 없다. Xdebug 는 "
                      "있는데 커버리지 산출물을 어디서 읽을지 모르면, 실행 줄 0 을 "
                      "'재서 0'이 아니라 '못 재서 0'으로 적게 된다.",
                      code=EXIT_CANNOT)
    if os.path.isfile(cov_path):
        os.remove(cov_path)
    set_toggle(env, "migrated", extra=clear_envelopes(env))
    capture(env, ctx, "migrated", captures(ctx["dir"], "coverage"))
    if not os.path.isfile(cov_path):
        return Result(False,
                      f"Xdebug 는 붙어 있는데 {cov_path} 가 생기지 않았다. 수집이 "
                      "배선되지 않은 것이다 — 배선 없는 커버리지를 0 으로 적지 않는다.",
                      code=EXIT_CANNOT)
    try:
        with open(cov_path, encoding="utf-8") as fh:
            cov = json.load(fh)
    except (OSError, ValueError) as exc:
        return Result(False, f"{cov_path} 를 읽을 수 없다: {exc}", code=EXIT_CANNOT)

    pins = env.maybe("legacy.seam.pinsFile", "pins.json")
    pins = pins if os.path.isabs(pins) else os.path.join(ctx["dir"], pins)
    try:
        with open(pins, encoding="utf-8") as fh:
            pinned = (json.load(fh).get("pins") or {}).values()
    except (OSError, ValueError) as exc:
        return Result(False,
                      f"{pins} 를 읽을 수 없다: {exc}. 어느 줄 범위가 '옮긴 레거시 "
                      "본문'인지는 핀만 알고 있다.",
                      code=EXIT_CANNOT)
    hit, where = 0, []
    for pin in pinned:
        lo, hi = (pin.get("lines") or [0, 0])[:2]
        for line_no, hits in (cov.get(pin.get("file")) or {}).items():
            try:
                n = int(line_no)
            except (TypeError, ValueError):
                continue
            if lo <= n <= hi and int(hits or 0) > 0:
                hit += 1
                where.append(f"{pin.get('symbol')}:{n}")
    return Result(hit == 0,
                  f"옮긴 본문의 실행 줄 {hit}"
                  + (f" [{', '.join(where[:6])}]" if where else " (0)"),
                  gauges={"legacy_lines": hit})


# ---- 7 복귀

def stage_restore(env, ctx):
    mode = set_toggle(env, "legacy", extra=clear_envelopes(env))
    return Result(True, f"토글 {mode} · 계측 봉투 해제 · 되읽기로 확인",
                  extra={"toggle": mode})


STAGE_FN = {1: stage_environment, 2: stage_noise, 3: stage_dual,
            4: stage_migrated, 5: stage_poison, 6: stage_coverage,
            7: stage_restore}


# --------------------------------------------------------------- 본체

def parse_stages(spec):
    want = []
    for part in str(spec).replace(" ", "").split(","):
        if not part:
            continue
        sep = ".." if ".." in part else ("-" if "-" in part[1:] else None)
        try:
            if sep:
                lo, _, hi = part.partition(sep)
                lo, hi = int(lo), int(hi)
                if lo > hi:
                    usage(f"--stage 범위가 거꾸로다: {part!r}")
                want += list(range(lo, hi + 1))
            else:
                want.append(int(part))
        except ValueError:
            usage(f"--stage 를 해석하지 못했다: {part!r}. `3`, `3,4,7`, `1..7` 형태다.")
    bad = [s for s in want if s not in STAGES]
    if bad:
        usage(f"모르는 단계 {bad}. 단계는 1~7 이다: "
              + " · ".join(f"{k} {v}" for k, v in STAGES.items()))
    seen, out = set(), []
    for s in want:                       # 순서는 번호 순이 아니라 **적은 순** 그대로
        if s not in seen:
            seen.add(s)
            out.append(s)
    return out


def main():
    o, pos = parse_opts(sys.argv[1:])
    if len(pos) != 1:
        usage("사용법: slicecheck <slice-dir> --stage <목록>   (--help 로 전체)")
    slice_dir = os.path.abspath(os.path.expanduser(pos[0]))

    if o.get("--init"):
        return cmd_init(slice_dir, o)
    if o.get("--show"):
        return cmd_show(slice_dir, bool(o.get("--json")))
    if not o.get("--stage"):
        usage("--stage 가 없다. `--stage 1,2` 나 `--stage 3..7` 처럼 준다.")
    want = parse_stages(o["--stage"])

    if not os.path.isdir(slice_dir):
        cannot(f"{slice_dir} 가 디렉터리가 아니다.")
    state, spath = read_state(slice_dir)

    cfg, cfg_path, problem = workspace(o.get("--config"))
    if problem:
        cannot(problem)

    corpus = o.get("--corpus") or os.path.join(slice_dir, "corpus.json")
    corpus = os.path.abspath(os.path.expanduser(corpus))
    needs_corpus = [s for s in want if s in (2, 3, 4, 5, 6)]
    if needs_corpus and not os.path.isfile(corpus):
        cannot(f"코퍼스가 없다 ({corpus}). 단계 {needs_corpus} 는 페이지를 두드려야 "
               "하고, 무엇을 두드릴지는 코퍼스만 알고 있다.")
    surface = o.get("--surface") or (corpus_surface(corpus)
                                    if os.path.isfile(corpus) else None)
    if not surface:
        usage("표면을 모른다. --surface 로 주거나 코퍼스에 surface 를 적어라.")

    env = Env(cfg, cfg_path, state["slice"], surface)
    ctx = {"dir": slice_dir, "corpus": corpus, "slice": state["slice"]}

    # ---- 상한. 재기 전에 본다.
    loops = sorted({STAGE_LOOP[s] for s in want if s in STAGE_LOOP})
    for name in loops:
        loop = state["loops"].get(name)
        if not loop:
            cannot(f"{spath} 의 loops 에 {name} 이 없다. 단계 "
                   f"{[s for s in want if STAGE_LOOP.get(s) == name]} 가 쓰는 "
                   "예산이고, 상한 없는 루프는 만들지 않는다.")
        # 측정 불가가 연속되면 크게 말하되 **막지 않는다.** 막으면 배선을 고친 뒤에도
        # 고쳤는지 확인할 길이 사라져 교착이 된다. 그리고 측정 불가 회차는 아래에서
        # 예산을 되돌리므로, 막아서 아껴야 할 예산 자체가 없다 — 여기서 필요한 것은
        # 정지가 아니라 사람이 그 사실을 못 보고 지나치지 않는 것이다.
        if state.get("unmeasurable", {}).get(name, 0) >= 2:
            sys.stderr.write(
                f"{TOOL}: 주의 — 루프 {name} 이 **측정 불가로 "
                f"{state['unmeasurable'][name]}회 연속** 끝났다. 회차는 소모되지 "
                "않았지만, 지금 고치고 있는 것이 이관이 아니라 계측일 수 있다. "
                "무엇을 검사할 수 없었는지는 앞 회차의 출력에 있다.\n")
        if loop["n"] >= loop["cap"]:
            sys.stderr.write(
                f"{TOOL}: 루프 {name} 이 상한에 닿았다 ({loop['n']}/{loop['cap']}). "
                "**진행하지 않았다** — 토글도 캡처도 건드리지 않았다. 같은 방법을 한 "
                "번 더 돌리는 것으로는 닫히지 않는 루프이므로, 되돌아갈 Phase 를 "
                f"사람이 정해야 한다. 게이지: "
                + " · ".join(f"{g}={fmt(state['gauges'].get(g))}" for g in GAUGES)
                + "\n")
            return EXIT_CAP

    if o.get("--dry-run"):
        print(f"{TOOL} --dry-run  {slice_dir}")
        print(f"  설정 {cfg_path} · 표면 {surface} · 코퍼스 {corpus}")
        print(f"  토글 변수 {env.toggle_var()}")
        for s in want:
            print(f"  단계 {s} {STAGES[s]}"
                  + (f"  (루프 {STAGE_LOOP[s]} "
                     f"{state['loops'][STAGE_LOOP[s]]['n']}"
                     f"/{state['loops'][STAGE_LOOP[s]]['cap']})"
                     if s in STAGE_LOOP else ""))
        return EXIT_OK

    for name in loops:
        state["loops"][name]["n"] += 1
    write_state(state, spath)            # 회차는 돌기 **전에** 센다
    # 전에 세는 이유: 중간에 죽은 실행도 회차를 쓴 것이다. 다만 **검사 자체가 돌지
    # 못한 회차**(exit 3)는 예산을 쓰지 않는다 — 측정이 일어나지 않았으므로 그 회차는
    # 루프에 대해 아무것도 말하지 않는다. 아래에서 되돌리고, 대신 연속 횟수를 센다.
    spent = list(loops)

    print(f"{TOOL} {state['slice']}  표면 {surface}  단계 "
          + ",".join(str(s) for s in want)
          + ("  루프 " + " · ".join(f"{n} {state['loops'][n]['n']}/"
                                    f"{state['loops'][n]['cap']}" for n in loops)
             if loops else ""))

    exit_code, results = EXIT_OK, []
    for s in want:
        res = STAGE_FN[s](env, ctx)
        results.append((s, res))
        verdict = ("건너뜀" if res.skip else ("통과" if res.ok else "실패"))
        print(f"  단계 {s} {STAGES[s]:<9} {verdict}  {res.line}")
        state["gauges"].update(res.gauges)
        state["toggle"] = res.extra.get("toggle", state.get("toggle"))
        if s in (2, 3):
            state["toggle"] = {2: "legacy", 3: "dual"}[s]
        elif s in (4, 5, 6):
            state["toggle"] = "migrated"
        if res.skip:
            state.setdefault("skips", {})[str(s)] = res.skip
        else:
            state.get("skips", {}).pop(str(s), None)
        state["rounds"].append({
            "n": state["loops"].get(STAGE_LOOP.get(s, ""), {}).get("n"),
            "stage": s, "verdict": verdict, "at": now(),
            "note": o.get("--note") or "",
            **{k: v for k, v in res.gauges.items() if v is not None}})
        write_state(state, spath)
        if not res.ok:
            exit_code = res.code
            note(f"단계 {s} 에서 멈춘다. 뒤 단계는 돌지 않았다 — 돌지 않은 검사는 "
                 "통과가 아니다.")
            break

    # 측정이 일어나지 않은 회차는 예산에서 되돌린다. 되돌린 사실을 조용히 두지 않고
    # `unmeasurable` 에 연속 횟수로 남긴다 — 두 번 연속이면 다음 호출이 멈춘다.
    unmeas = state.setdefault("unmeasurable", {})
    if exit_code == EXIT_CANNOT:
        for name in spent:
            state["loops"][name]["n"] = max(0, state["loops"][name]["n"] - 1)
            unmeas[name] = unmeas.get(name, 0) + 1
        note("검사가 돌지 못했으므로 회차를 되돌렸다 ("
             + " · ".join(f"{n} {state['loops'][n]['n']}/{state['loops'][n]['cap']}"
                          f" · 측정 불가 {unmeas[n]}회 연속" for n in spent)
             + "). 다음에 고칠 것은 이관이 아니라 계측이다.")
    else:
        for name in spent:
            if unmeas.pop(name, 0):
                note(f"루프 {name} 의 측정 불가 연속 횟수를 0 으로 되돌렸다.")
    write_state(state, spath)

    print("  게이지 " + " · ".join(
        f"{g}={fmt(state['gauges'].get(g))}" for g in GAUGES) + f"  → {spath}")
    if o.get("--json"):
        print(json.dumps({"slice": state["slice"], "surface": surface,
                          "stages": [{"stage": s, "ok": r.ok, "code": r.code,
                                      "skip": r.skip, "line": r.line}
                                     for s, r in results],
                          "gauges": state["gauges"], "loops": state["loops"],
                          "exit": exit_code}, ensure_ascii=False, indent=2))
    return exit_code


FLAGS = {"--init", "--show", "--json", "--dry-run"}
VALUED = {"--stage", "--corpus", "--surface", "--note", "--config", "--slice",
          "--unit", "--area", "--depth", "--cap"}


def parse_opts(argv):
    o, pos, i = {}, [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help", "help"):
            print(__doc__.strip())
            sys.exit(EXIT_OK)
        if a in FLAGS:
            o[a] = True
            i += 1
        elif a in VALUED:
            if i + 1 >= len(argv):
                usage(f"{a} 에 값이 없다")
            o[a] = argv[i + 1]
            i += 2
        elif a.startswith("-"):
            usage(f"모르는 옵션 {a!r}. --help 로 쓸 수 있는 옵션을 봐라.")
        else:
            pos.append(a)
            i += 1
    return o, pos


if __name__ == "__main__":
    sys.exit(main())
