#!/usr/bin/env python3
"""dualrun-report - 이중 실행 로그를 읽어 '예상 밖 불일치' 만 남긴다.

    dualrun-report [--log <path>] [--ignore ignore.json] [--since <ISO>]
                   [--experiment <name>] [--as-fixtures <out.json>] [--json]
                   [--fixture-limit 3] [--config <file>]

    --log <path>          JSONL 로그. 기본값은 legacy.dualRun.logPath
    --ignore <file>       의도수정 행에서 만든 예상 불일치 목록
    --since <ISO>         이 시각 이후의 줄만 (예: 2026-09-08T12:00:00+09:00)
    --experiment <name>   실험 하나만
    --as-fixtures <out>   예상 밖 샘플을 회귀 픽스처 JSON 으로 저장
    --fixture-limit N     서명 하나당 저장·표시할 샘플 수 (기본 3)
    --json                기계용 요약
    --config <file>       workspace.json 위치

**이 도구가 답하는 질문 하나.** "레거시와 새 백엔드가 다르게 답한 입력이 있는가, 그리고
그 다름이 우리가 미리 승인한 것인가." 승인한 다름은 `ignore.json` 에 있다 — 원장의
`의도수정` 행에서 만들어지고, 행 ID 를 달고 있다. 그러니 이 도구의 출력에서 볼 것은
**예상 밖** 숫자 하나이고, Phase 6 의 루프는 그 숫자가 0 이 될 때 닫힌다.

**불일치를 건별로 나열하지 않고 `diff_keys` 서명으로 묶는다.** 같은 규칙 하나가 빠지면
불일치는 수백 건이 나오지만 서명은 하나다. 사람이 읽어야 하는 것은 건수가 아니라 서명의
가짓수이고, 그것이 곧 "몇 개의 규칙이 어긋났는가" 다.

**깨진 줄이 하나라도 있으면 exit 2 다.** 이 도구의 초록은 "예상 밖 0건"인데, 읽지 못한
줄이 있으면 그것을 말할 수 없다. 못 읽은 것을 없는 것으로 세면 이 도구가 막으려는 실패를
이 도구가 저지르는 것이다. 로그는 헬퍼가 `LOCK_EX` 로 한 줄씩 붙이므로 깨진 줄은
정상 상태가 아니다 — 디스크가 찼거나, 두 프로세스가 다른 경로를 같은 파일로 알고 있거나,
컨테이너 마운트가 어긋난 것이다.

종료 코드: 0 예상 밖 0건 · 1 예상 밖 있음 · 2 로그 없음·비었음·깨짐·설정 없음 (stderr 에 이유).
"""
import datetime
import json
import os
import re
import sys

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

CONFIG_REL = os.path.join(".claude", "config", "workspace.json")
TOOL = "dualrun-report"


def die(msg, code=2):
    sys.stderr.write(f"{TOOL}: {msg}\n")
    sys.exit(code)


def note(msg):
    sys.stderr.write(f"{TOOL}: {msg}\n")


# --------------------------------------------------------------- 설정

def config_path(explicit):
    if explicit:
        return os.path.abspath(os.path.expanduser(explicit))
    try:
        from _phpenc import project_dir
        root = project_dir()
    except Exception:
        root = None
    if not root:
        d = HERE
        while d and not os.path.isfile(os.path.join(d, CONFIG_REL)):
            parent = os.path.dirname(d)
            d = None if parent == d else parent
        root = d
    if not root:
        die(f"{CONFIG_REL} 을 찾지 못했다. --config 로 위치를 주거나 --log 로 로그를 "
            "직접 가리켜라.")
    return os.path.join(root, CONFIG_REL)


def load_config(explicit):
    path = config_path(explicit)
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh), path
    except (OSError, ValueError) as exc:
        die(f"{path} 를 읽을 수 없다: {exc}")


def opt(cfg, dotted, default=None):
    cur = cfg
    for part in dotted.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return default if cur in ("", None) else cur


# --------------------------------------------------------------- ignore

def load_ignore(path):
    """(rules, 문제). 규칙 하나라도 형태가 어긋나면 멈춘다 — 조용히 안 맞는 규칙은
    '예상 밖'을 만들고, 그 예상 밖은 사람을 잘못된 곳으로 보낸다."""
    try:
        with open(path, encoding="utf-8") as fh:
            doc = json.load(fh)
    except (OSError, ValueError) as exc:
        die(f"ignore 파일을 읽을 수 없다 ({path}): {exc}")
    rules = doc.get("rules") if isinstance(doc, dict) else None
    if not isinstance(rules, list):
        die(f"{path} 에 rules 배열이 없다. "
            '{"rules":[{"experiment":"<name>","keys":["total"],"ledger":"R-17",'
            '"reason":"의도수정: ..."}]} 형태여야 한다.')
    for i, r in enumerate(rules):
        if not isinstance(r, dict):
            die(f"{path} rules[{i}] 가 객체가 아니다")
        keys = r.get("keys")
        if not isinstance(keys, list) or not keys or any(
                not isinstance(k, str) for k in keys):
            die(f"{path} rules[{i}] 의 keys 가 문자열 배열이 아니다")
        if not r.get("ledger"):
            note(f"{path} rules[{i}] 에 ledger 가 없다 — 예상 불일치는 원장의 "
                 "의도수정 행에서 나와야 한다. 행 ID 없이 무시하면 근거가 사라진다.")
    return rules


def key_covered(diff_key, rule_key):
    """규칙 키가 diff 키를 덮는가. `items[].title` 은 `items[0].title` 을 덮고,
    `items` 는 그 아래 전부를 덮는다."""
    rx = re.escape(rule_key).replace(r"\[\]", r"\[\d+\]").replace(r"\[\*\]", r"\[\d+\]")
    try:
        return re.fullmatch(rx + r"([.\[].*)?", diff_key) is not None
    except re.error:
        return diff_key == rule_key


def matching_rules(rec, rules):
    """(전부 덮였는가, 관련 규칙 목록). diff_keys 가 비면 덮은 것으로 보지 않는다."""
    keys = [k for k in (rec.get("diff_keys") or []) if isinstance(k, str)]
    exp = rec.get("experiment")
    related, covered = [], set()
    for r in rules:
        rexp = r.get("experiment")
        if rexp and rexp != "*" and rexp != exp:
            continue
        hit = {k for k in keys for rk in r["keys"] if key_covered(k, rk)}
        if hit:
            related.append(r)
            covered |= hit
    return (bool(keys) and covered == set(keys)), related


# --------------------------------------------------------------- 로그

REQUIRED = ("experiment", "equal")


def read_log(path, since, only_exp):
    """(records, 통계). 못 읽은 줄을 세어 돌려준다 — 건너뛰고 조용히 있지 않는다."""
    if not os.path.isfile(path):
        die(f"로그가 없다: {path}. 토글이 dual 이었는지, 로그 경로가 컨테이너 안으로 "
            "마운트돼 있는지 확인해라. 빈 로그와 '로그가 없다'는 다른 사실이다.")
    recs, broken_json, broken_schema, skipped_mode, filtered = [], [], [], 0, 0
    total_lines = 0
    with open(path, "rb") as fh:
        for n, raw in enumerate(fh, 1):
            total_lines = n
            line = raw.strip()
            if not line:
                continue
            try:
                rec = json.loads(line.decode("utf-8"))
            except (ValueError, UnicodeDecodeError):
                broken_json.append(n)
                continue
            if not isinstance(rec, dict) or any(k not in rec for k in REQUIRED):
                broken_schema.append(n)
                continue
            if rec.get("mode") and rec["mode"] != "dual":
                skipped_mode += 1
                continue
            if only_exp and rec.get("experiment") != only_exp:
                filtered += 1
                continue
            if since is not None:
                ts = parse_ts(rec.get("ts"))
                if ts is None or ts < since:
                    filtered += 1
                    continue
            recs.append(rec)
    return recs, {"lines": total_lines, "broken_json": broken_json,
                  "broken_schema": broken_schema, "skipped_mode": skipped_mode,
                  "filtered": filtered}


def parse_ts(value):
    if not isinstance(value, str):
        return None
    try:
        dt = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.astimezone()
    return dt


def short(value, width=88):
    try:
        s = json.dumps(value, ensure_ascii=False, sort_keys=True)
    except (TypeError, ValueError):
        s = repr(value)
    return s if len(s) <= width else s[:width - 1] + "…"


# --------------------------------------------------------------- 본체

def main():
    o = parse_opts(sys.argv[1:])
    cfg, cfg_file = (None, None)
    log = o.get("--log")
    if not log:
        cfg, cfg_file = load_config(o.get("--config"))
        log = opt(cfg, "legacy.dualRun.logPath")
        if not log:
            die(f"{cfg_file} 에 legacy.dualRun.logPath 가 없다. 그 키를 채우거나 "
                "--log 로 경로를 직접 줘라.")
    log = os.path.abspath(os.path.expanduser(log))

    since = None
    if o.get("--since"):
        since = parse_ts(o["--since"])
        if since is None:
            die(f"--since 를 ISO 시각으로 읽지 못했다: {o['--since']!r}")

    rules = load_ignore(os.path.expanduser(o["--ignore"])) if o.get("--ignore") else []
    limit = int(o.get("--fixture-limit") or 3)
    recs, stat = read_log(log, since, o.get("--experiment"))

    per = {}
    groups = {}
    for rec in recs:
        exp = rec.get("experiment") or "<이름 없음>"
        s = per.setdefault(exp, {"total": 0, "equal": 0, "mismatch": 0, "expected": 0,
                                 "unexpected": 0, "candidate_error": 0, "truncated": 0,
                                 "control_ms": 0, "candidate_ms": 0})
        s["total"] += 1
        s["control_ms"] += rec.get("control_ms") or 0
        s["candidate_ms"] += rec.get("candidate_ms") or 0
        if rec.get("truncated"):
            s["truncated"] += 1
        if rec.get("candidate_error"):
            s["candidate_error"] += 1
        if rec.get("equal"):
            s["equal"] += 1
            continue
        s["mismatch"] += 1
        covered, related = matching_rules(rec, rules)
        if covered:
            s["expected"] += 1
            continue
        s["unexpected"] += 1
        sig = tuple(sorted(k for k in (rec.get("diff_keys") or [])
                           if isinstance(k, str))) or ("<diff_keys 없음>",)
        g = groups.setdefault((exp, sig), {"count": 0, "samples": [], "ledger": set()})
        g["count"] += 1
        g["ledger"] |= {r["ledger"] for r in related if r.get("ledger")}
        if len(g["samples"]) < limit:
            g["samples"].append(rec)

    unexpected = sum(v["unexpected"] for v in per.values())
    broken = len(stat["broken_json"]) + len(stat["broken_schema"])

    if o.get("--json"):
        print(json.dumps({
            "log": log, "records": len(recs), "broken": broken,
            "broken_json_lines": stat["broken_json"][:50],
            "broken_schema_lines": stat["broken_schema"][:50],
            "filtered_out": stat["filtered"], "non_dual_rows": stat["skipped_mode"],
            "experiments": per, "unexpected": unexpected,
            "groups": [{"experiment": e, "signature": list(sig), "count": g["count"],
                        "ledger": sorted(g["ledger"]),
                        "samples": [sample_of(r) for r in g["samples"]]}
                       for (e, sig), g in sorted(groups.items())],
        }, ensure_ascii=False, indent=2))
    else:
        report(log, recs, stat, per, groups, rules, since)

    if o.get("--as-fixtures"):
        write_fixtures(o["--as-fixtures"], groups)

    if broken:
        die(f"읽지 못한 줄이 {broken}개 있다 "
            f"(JSON 아님: {stat['broken_json'][:10]}, 스키마 어긋남: "
            f"{stat['broken_schema'][:10]}). 그 줄들이 무엇이었는지 모르는 채로는 "
            "'예상 밖 0건'을 말할 수 없다.")
    if not recs:
        die(f"조건에 맞는 줄이 하나도 없다 ({log}, 전체 {stat['lines']}줄, "
            f"걸러진 줄 {stat['filtered']}개). 로그가 비었다면 토글이 PHP 에 "
            "도달하지 않은 것이다 — 되읽기부터 확인해라.")
    return 1 if unexpected else 0


def sample_of(rec):
    out = {"input": rec.get("input"), "control": rec.get("control"),
           "candidate": rec.get("candidate")}
    for k in ("ts", "page", "caller", "truncated", "candidate_error"):
        if rec.get(k) is not None:
            out[k] = rec[k]
    return out


def report(log, recs, stat, per, groups, rules, since):
    span = [parse_ts(r.get("ts")) for r in recs]
    span = sorted(t for t in span if t)
    print(f"{TOOL}: {log}")
    print(f"  줄 {stat['lines']} · 집계 {len(recs)} · 걸러냄 {stat['filtered']}"
          f" · dual 아닌 줄 {stat['skipped_mode']} · 깨진 줄 "
          f"{len(stat['broken_json']) + len(stat['broken_schema'])}"
          + (f" · {span[0]:%Y-%m-%d %H:%M} ~ {span[-1]:%Y-%m-%d %H:%M}" if span else "")
          + (f" · --since {since:%Y-%m-%d %H:%M}" if since else ""))
    print(f"  ignore 규칙 {len(rules)}개"
          + ("" if rules else "  (없음 — 의도수정 행이 있다면 전부 예상 밖으로 잡힌다)"))

    print(f"\n{'실험':<34}{'총':>6}{'equal':>7}{'불일치':>8}{'예상':>7}"
          f"{'예상밖':>8}{'예외':>6}{'절단':>6}   ms(ctl/cand)")
    for exp in sorted(per):
        s = per[exp]
        n = max(s["total"], 1)
        print(f"{exp:<34}{s['total']:>6}{s['equal']:>7}{s['mismatch']:>8}"
              f"{s['expected']:>7}{s['unexpected']:>8}{s['candidate_error']:>6}"
              f"{s['truncated']:>6}   {s['control_ms'] // n}/{s['candidate_ms'] // n}")

    if not groups:
        print("\n예상 밖 불일치 없음.")
        return
    print(f"\n예상 밖 불일치 — diff_keys 서명 {len(groups)}가지")
    for i, ((exp, sig), g) in enumerate(sorted(groups.items()), 1):
        hint = ", ".join(sorted(g["ledger"])) if g["ledger"] else "없음"
        print(f"\n [{i}] {exp}  {g['count']}건   원장 힌트: {hint}")
        print(f"     서명: {', '.join(sig)}")
        for j, rec in enumerate(g["samples"], 1):
            print(f"     샘플 {j}  input     {short(rec.get('input'))}")
            if rec.get("truncated"):
                print(f"              (truncated — 본문 없이 sha 만: "
                      f"{str(rec.get('control_sha'))[:12]} / "
                      f"{str(rec.get('candidate_sha'))[:12]})")
            else:
                print(f"              control   {short(rec.get('control'))}")
                print(f"              candidate {short(rec.get('candidate'))}")
            if rec.get("candidate_error"):
                print(f"              candidate 예외 {short(rec['candidate_error'])}")
            where = rec.get("caller") or rec.get("page")
            if where:
                print(f"              호출자    {where}")


def write_fixtures(path, groups):
    """예상 밖 샘플을 회귀 픽스처로. 서명마다 몇 건씩만 — 같은 규칙이 만든 수백 건을
    전부 저장해도 알려주는 것은 같다."""
    fixtures = [{"experiment": exp, "input": rec.get("input"),
                 "control": rec.get("control"), "candidate": rec.get("candidate")}
                for (exp, _sig), g in sorted(groups.items()) for rec in g["samples"]]
    try:
        with open(os.path.expanduser(path), "w", encoding="utf-8") as fh:
            json.dump(fixtures, fh, ensure_ascii=False, indent=2, sort_keys=True)
    except OSError as exc:
        die(f"픽스처를 쓸 수 없다 ({path}): {exc}")
    note(f"픽스처 {len(fixtures)}건 → {path}")


def parse_opts(argv):
    flags = {"--json"}
    valued = {"--log", "--ignore", "--since", "--experiment", "--as-fixtures",
              "--fixture-limit", "--config"}
    o, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help", "help"):
            print(__doc__.strip())
            sys.exit(0)
        if a in flags:
            o[a] = True
            i += 1
            continue
        if a in valued:
            if i + 1 >= len(argv):
                die(f"{a} 에 값이 없다")
            o[a] = argv[i + 1]
            i += 2
            continue
        die(f"모르는 인자 {a!r}. --help 로 쓸 수 있는 옵션을 봐라.")
    return o


if __name__ == "__main__":
    sys.exit(main())
